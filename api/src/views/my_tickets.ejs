<%- include('partials/header') %>

<h1>Mes billets</h1>
<% if (!tickets.length) { %>
    <p>Aucun billet pour le moment.</p>
<% } else { %>
<table>
    <thead>
        <tr><th>Evenement</th><th>Date</th><th>Categorie</th><th>Prix paye</th><th>Achete le</th><th></th></tr>
    </thead>
    <tbody>
        <% tickets.forEach(t => { %>
            <tr>
                <td><a href="/events/<%= t.eventId %>"><%= t.eventArtist %></a> (<%= t.locationName %>)</td>
                <td><%= new Date(t.eventDate).toLocaleDateString('fr-FR') %></td>
                <td><%= t.categoryName %></td>
                <td><%= t.pricePaid %> EUR</td>
                <td><%= new Date(t.ticketCreateAt).toLocaleString('fr-FR') %></td>
                <td>
                    <form action="/tickets/<%= t.ticketId %>/cancel" method="post">
                        <button type="submit">Annuler</button>
                    </form>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>
<% } %>

<%- include('partials/footer') %>
