<%- include('partials/header') %>

<a href="/">&larr; Retour</a>
<h1><%= event.artist %></h1>
<p><%= event.locationName %> - <%= event.locationAdress %>, <%= event.locationCity %></p>
<p><strong><%= new Date(event.eventDate).toLocaleString('fr-FR') %></strong></p>

<% if (error) { %>
    <p class="error"><%= error %></p>
<% } %>

<% const c = event.content; %>
<% if (c) { %>
    <section class="panel">
        <p>
            <span class="tag"><%= c.genre %></span>
            <% (c.tags || []).forEach(t => { %><span class="tag"><%= t %></span><% }) %>
            <% if (c.rating && c.rating.count) { %> &#9733; <%= c.rating.avg %> / 5 (<%= c.rating.count %> avis)<% } %>
        </p>
        <p><%= c.description %></p>
        <% if (c.lineup && c.lineup.length) { %>
            <h3>Programme</h3>
            <ul>
                <% c.lineup.forEach(l => { %><li><%= l.startTime %> &mdash; <%= l.name %></li><% }) %>
            </ul>
        <% } %>
        <% if (c.venueInfo) { %>
            <p class="muted">
                Ouverture des portes : <%= c.venueInfo.doorsOpen %> &middot; Age minimum : <%= c.venueInfo.ageLimit %> ans
                <% if (c.venueInfo.access && c.venueInfo.access.length) { %>&middot; Acces : <%= c.venueInfo.access.join(', ') %><% } %>
            </p>
        <% } %>
    </section>
<% } %>

<h2>Categories</h2>
<div class="grid">
    <% event.categories.forEach(cat => { %>
        <div class="card">
            <h3><%= cat.categoryName %></h3>
            <p><%= cat.price %> EUR</p>
            <p><%= cat.availableCount %> place(s) disponible(s) / <%= cat.totalQuantity %></p>
            <% if (currentUser) { %>
                <form action="/events/<%= event.eventId %>/buy" method="post">
                    <input type="hidden" name="categoryId" value="<%= cat.categoryId %>">
                    <button type="submit" <% if (cat.availableCount <= 0) { %>disabled<% } %>>
                        <%= cat.availableCount <= 0 ? 'Complet' : 'Acheter' %>
                    </button>
                </form>
            <% } %>
        </div>
    <% }) %>
</div>
<% if (!currentUser) { %>
    <p><a href="/login">Connectez-vous</a> pour acheter un billet.</p>
<% } %>

<h2>Avis (<%= reviews.total %>)</h2>
<% const maxCount = Math.max(1, ...distribution.map(d => d.count)); %>
<div class="distribution">
    <% distribution.slice().reverse().forEach(d => { %>
        <div><span><%= d.stars %> &#9733;</span><i style="width: <%= Math.round(d.count / maxCount * 100) %>%"></i><span><%= d.count %></span></div>
    <% }) %>
</div>

<% if (currentUser) { %>
    <form id="review-form" class="form">
        <h3><%= myReview ? 'Mon avis' : 'Laisser un avis' %></h3>
        <label>Note
            <select name="rating">
                <% [5,4,3,2,1].forEach(n => { %><option value="<%= n %>" <%= myReview && myReview.rating === n ? 'selected' : '' %>><%= n %> / 5</option><% }) %>
            </select>
        </label>
        <label>Commentaire <input type="text" name="comment" maxlength="2000" value="<%= myReview ? myReview.comment : '' %>"></label>
        <div class="actions">
            <button type="submit"><%= myReview ? 'Modifier mon avis' : 'Publier mon avis' %></button>
            <% if (myReview) { %><button type="button" class="danger" id="review-delete">Supprimer mon avis</button><% } %>
        </div>
        <p id="review-msg" class="muted"></p>
    </form>
<% } %>

<% if (currentUser && currentUser.role === 'admin') { %>
    <p><a href="/admin/content/<%= event.eventId %>">Gerer le contenu MongoDB de cet evenement</a></p>
<% } %>

<ul class="reviews">
    <% reviews.items.forEach(r => { %>
        <li>
            <strong><%= r.author %></strong> &#9733; <%= r.rating %>/5
            <span class="muted"><%= new Date(r.createdAt).toLocaleDateString('fr-FR') %></span>
            <% if (currentUser && currentUser.role === 'admin') { %>
                <button type="button" class="danger small" data-moderate="<%= r._id %>">Supprimer</button>
            <% } %>
            <br><%= r.comment %>
        </li>
    <% }) %>
</ul>

<% if (currentUser) { %>
    <script>
        // Le front appelle l'API REST JSON (collection MongoDB "reviews")
        const base = '/api/events/<%= event.eventId %>/reviews';
        const msg = document.getElementById('review-msg');
        async function call(method, url, body) {
            const res = await fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: body && JSON.stringify(body),
            });
            if (res.ok) return location.reload();
            const data = await res.json().catch(() => ({}));
            msg.textContent = data.error || 'Erreur';
        }
        document.getElementById('review-form').addEventListener('submit', (ev) => {
            ev.preventDefault();
            const f = ev.target;
            const body = { rating: Number(f.rating.value), comment: f.comment.value };
            <% if (myReview) { %>call('PUT', base + '/me', body);<% } else { %>call('POST', base, body);<% } %>
        });
        document.getElementById('review-delete')?.addEventListener('click', () => {
            if (confirm('Supprimer votre avis ?')) call('DELETE', base + '/me');
        });
        document.querySelectorAll('[data-moderate]').forEach((btn) => btn.addEventListener('click', () => {
            if (confirm('Supprimer cet avis ?')) call('DELETE', '/api/reviews/' + btn.dataset.moderate);
        }));
    </script>
<% } %>

<%- include('partials/footer') %>
