<%- include('partials/header') %>

<h1>Inscription</h1>
<% if (error) { %>
    <p class="error"><%= error %></p>
<% } %>
<form action="/register" method="post" class="form">
    <label>Prenom <input type="text" name="name" required></label>
    <label>Nom <input type="text" name="lastName" required></label>
    <label>Email <input type="email" name="email" required></label>
    <label>Mot de passe (8 caracteres min.) <input type="password" name="password" minlength="8" required></label>
    <button type="submit">S'inscrire</button>
</form>

<%- include('partials/footer') %>
