# Copier ce fichier en `.env` (cp .env.example .env). Valeurs de DEMO uniquement :
# changez-les pour tout autre usage. Le fichier .env n'est jamais versionne.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me_root
APP_DB_PASSWORD=change_me_app
REPORT_DB_PASSWORD=change_me_report

# --- MongoDB ---
MONGO_ROOT_USER=mongo_root
MONGO_ROOT_PASSWORD=change_me_mongo_root
MONGO_APP_USER=ticket_app
MONGO_APP_PASSWORD=change_me_mongo_app

# --- API ---
SESSION_SECRET=change_me_session_secret
